import java.util.*;

class Solution {
    public List<String> braceExpansionII(String expression) {
        Set<String> result = dfs(expression);
        return new ArrayList<>(result);
    }

    private Set<String> dfs(String s) {
        Set<String> result = new TreeSet<>();

        int open = -1;
        int balance = 0;

        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) == '{') {
                if (balance == 0) {
                    open = i;
                }
                balance++;
            } else if (s.charAt(i) == '}') {
                balance--;

                if (balance == 0) {
                    String inside = s.substring(open + 1, i);
                    List<String> parts = split(inside);

                    for (String part : parts) {
                        result.addAll(dfs(s.substring(0, open) + part + s.substring(i + 1)));
                    }

                    return result;
                }
            }
        }

        result.add(s);
        return result;
    }

    private List<String> split(String s) {
        List<String> parts = new ArrayList<>();
        int start = 0;
        int balance = 0;

        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) == '{') {
                balance++;
            } else if (s.charAt(i) == '}') {
                balance--;
            } else if (s.charAt(i) == ',' && balance == 0) {
                parts.add(s.substring(start, i));
                start = i + 1;
            }
        }

        parts.add(s.substring(start));
        return parts;
    }
}
